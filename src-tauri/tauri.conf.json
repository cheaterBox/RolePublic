{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Roletect",
  "version": "0.1.4",
  "identifier": "com.ahmedtrooper.roletect",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Roletect",
        "width": 1200,
        "height": 800,
        "decorations": false,
        "shadow": true,
        "resizable": true,
        "zoomHotkeysEnabled": false
      }
    ],
    "security": {
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      },
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDI5NkNFRUU4RjA5NERCMjIKUldRaTI1VHc2TzVzS1N5QWJXY1NqVnZtanJWeitmQlRTS3BrYUkvT3F0aXVOWXVlK2lpME9vbDkK",
      "endpoints": [
        "https://github.com/AhmedTrooper/roletect-app/releases/latest/download/latest.json"
      ]
    }
  }
}
