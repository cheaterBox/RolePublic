# =============================================================================
# RoleTect VPS Application Environment Configuration
# =============================================================================

# Server Binding & Auth
API_PORT=8080
WEB_PORT=3000
ROLETECT_API_TOKEN=roletect_vps_master_token_2026
REQUIRE_TOKEN=true
RATE_LIMIT_RPM=1200
LOG_FORMAT=json
RUST_LOG=info,roletect_api=debug

# Database (PostgreSQL / SQLite)
DB_DRIVER=postgres
DATABASE_URL=postgres://roletect:roletect_secret_password@postgres:5432/roletect
PG_USER=roletect
PG_PASSWORD=roletect_secret_password
PG_DB=roletect
PG_PORT=5432

# Redis Cache & Pub/Sub
REDIS_PORT=6379
REDIS_URL=redis://redis:6379

# S3 / MinIO Cloud Backup Storage
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
S3_ENDPOINT=http://minio:9000
S3_BUCKET=roletect-backups
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_FORCE_PATH_STYLE=true

# Next.js Frontend
NEXT_PUBLIC_API_URL=http://localhost:8080
